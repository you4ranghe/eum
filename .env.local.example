# ─────────────────────────────────────────────────────────────
# Supabase (https://supabase.com/dashboard → Project Settings → API)
# ─────────────────────────────────────────────────────────────
# 브라우저 노출 전제. RLS(Row Level Security)가 실제 권한을 강제하므로 공개해도 안전하다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 서버 전용. RLS를 우회하므로 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것.
# Route Handler에서 외부 API 결과를 캐시 테이블에 쓸 때만 사용한다.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─────────────────────────────────────────────────────────────
# 지도 SDK (브라우저 노출. 각 콘솔에서 도메인 화이트리스트 필수)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=your_ncp_key_id
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key

# ─────────────────────────────────────────────────────────────
# 서버 전용 검색/경로 API 키 (브라우저에 절대 노출 금지)
# ─────────────────────────────────────────────────────────────
# 네이버 클라우드 플랫폼: Local Search + Directions 5
NAVER_API_KEY_ID=
NAVER_API_KEY=
# 구글: Places API + Routes API (서버용 키, 도메인 제한 대신 IP/API 제한 사용)
GOOGLE_MAPS_SERVER_KEY=

# ─────────────────────────────────────────────────────────────
# 앱 기본값
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_MAP_PROVIDER=naver
NEXT_PUBLIC_DEFAULT_REGION=jeju
