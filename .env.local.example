# ═══════════════════════════════════════════════════════════════
# 이음(Eum) 환경변수
#
# 이 파일을 .env.local 로 복사해서 값을 채운다.
# 발급 방법은 docs/api-keys-setup.md 참고.
#
# ⚠️ NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저 번들에 그대로 들어간다.
#    "숨겨진 값"이 아니라 "공개해도 되도록 콘솔에서 제한을 건 값"이어야 한다.
# ═══════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────
# 1. 네이버 클라우드 플랫폼  (https://console.ncloud.com)
#    → 지도 표시, 길찾기. 결제수단 등록 필수.
# ───────────────────────────────────────────────────────────────

# Maps > Application 등록 후 발급되는 Key ID.
# 브라우저에 노출되지만, 콘솔의 "Web 서비스 URL"에 등록한 도메인에서만 동작한다.
NEXT_PUBLIC_NCP_MAP_KEY_ID=

# Directions 5 (길찾기) 서버 호출용. 절대 NEXT_PUBLIC_ 붙이지 말 것.
NCP_API_KEY_ID=
NCP_API_KEY=


# ───────────────────────────────────────────────────────────────
# 2. 네이버 개발자센터  (https://developers.naver.com)
#    → 지역(장소) 검색. NCP와 완전히 별개의 서비스. 무료.
# ───────────────────────────────────────────────────────────────
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=


# ───────────────────────────────────────────────────────────────
# 3. Google Cloud  (https://console.cloud.google.com)
#    → 키를 반드시 2개로 분리한다. 제한 방식이 서로 다르기 때문.
# ───────────────────────────────────────────────────────────────

# 브라우저용: Maps JavaScript API 만 허용 + HTTP 리퍼러 제한
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 서버용: Places API (New) + Routes API 만 허용, 리퍼러 제한 없음
# (서버는 리퍼러 헤더를 보내지 않으므로 리퍼러 제한을 걸면 전부 거부된다)
GOOGLE_MAPS_SERVER_KEY=


# ───────────────────────────────────────────────────────────────
# 4. Supabase  (https://supabase.com/dashboard → Project Settings → API)
# ───────────────────────────────────────────────────────────────

# 공개 전제. 실제 권한은 RLS가 강제한다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# RLS를 우회한다. 공용 캐시 테이블 쓰기에만 사용. 유출되면 전체 DB가 열린다.
SUPABASE_SERVICE_ROLE_KEY=


# ───────────────────────────────────────────────────────────────
# 5. 앱 기본값
# ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_MAP_PROVIDER=naver
NEXT_PUBLIC_DEFAULT_REGION=jeju
